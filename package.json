{
  "name": "mehnat-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "bot:dev": "tsx watch bot/main.ts",
    "bot:start": "tsx bot/main.ts",
    "bot:webhook": "tsx scripts/set-telegram-webhook.ts",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "node -e \"if(process.env.NODE_ENV==='production'){console.error('\\u2716 db push is DEV-ONLY. Production uses: npx prisma migrate deploy');process.exit(1)}\" && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "seed:deadlines": "tsx scripts/seed-deadline-templates.ts --no-generate",
    "obligations:generate": "tsx scripts/generate-obligations.ts",
    "verify:clean-start": "tsx scripts/verify-clean-start.ts",
    "smoke:telegram": "tsx scripts/smoke-telegram-app.ts",
    "backup": "bash scripts/backup.sh",
    "preflight": "tsx scripts/preflight.ts",
    "deploy": "bash scripts/deploy.sh",
    "migrate:data": "npx tsx scripts/migrate-data.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:setup": "bash scripts/setup-test-db.sh",
    "recovery:status": "tsx scripts/recovery-status.ts",
    "recovery:b4:preview": "tsx scripts/recovery-b4-preview.ts --save .recovery/b4-baseline.json",
    "recovery:b4:cancel": "tsx scripts/recovery-b4-cancel.ts --baseline .recovery/b4-baseline.json",
    "recovery:b4:postcheck": "tsx scripts/recovery-b4-postcheck.ts --baseline .recovery/b4-baseline.json",
    "recovery:b3:precheck": "tsx scripts/recovery-b3-precheck.ts",
    "recovery:b4b:preview": "tsx scripts/recovery-b4b-preview.ts --save .recovery/b4b-baseline.json",
    "recovery:b4b:clear": "tsx scripts/recovery-b4b-clear.ts --baseline .recovery/b4b-baseline.json",
    "recovery:b4b:postcheck": "tsx scripts/recovery-b4b-postcheck.ts --baseline .recovery/b4b-baseline.json",
    "seed:own-accounts": "tsx scripts/seed-own-firm-accounts.ts",
    "seed:kassa-desks": "tsx scripts/seed-kassa-desks.ts",
    "import:transit": "tsx scripts/import-transit.ts",
    "import:kassa-ops": "tsx scripts/import-kassa-operations.ts",
    "import:firm-balances": "tsx scripts/import-firm-balances.ts"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.5",
    "exceljs": "^4.4.0",
    "grammy": "^1.45.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
