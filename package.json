{
  "name": "mehnat-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "bot:dev": "tsx watch bot/main.ts",
    "bot:start": "tsx bot/main.ts",
    "bot:webhook": "tsx scripts/set-telegram-webhook.ts",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "node -e \"if(process.env.NODE_ENV==='production'){console.error('\\u2716 db push is DEV-ONLY. Production uses: npx prisma migrate deploy');process.exit(1)}\" && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "preflight": "tsx scripts/preflight.ts",
    "deploy": "bash scripts/deploy.sh",
    "migrate:data": "npx tsx scripts/migrate-data.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.5",
    "grammy": "^1.45.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
