# ─────────────────────────────────────────────────────────────
# ASRO — environment template.
# Copy to `.env.local` (Next.js) and/or `.env` (bot/scripts) and fill in.
# Docker Compose loads `.env` into the web+bot containers, so for a Compose
# deploy `.env` must be COMPLETE (auth vars included), not just DATABASE_URL.
# NEVER commit real secrets — `.env*` is gitignored.
# ─────────────────────────────────────────────────────────────

# ===== CORE (required) =====
# Postgres connection string used by Prisma (via the pg driver adapter).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# next-auth v5 secret. Generate with:  openssl rand -base64 32
AUTH_SECRET="change-me-32-bytes-base64"

# Public base URL of the app (used by next-auth + metadata).
# In production set these to your real origin, e.g. https://asro.uz
# NOTE: an https:// value is what makes next-auth issue the __Secure- session
# cookie (and proxy.ts read it back with the matching prefix). Keep it https in prod.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Trust the reverse-proxy (nginx / AWS ALB) forwarded Host. The app now sets
# `trustHost: true` in code (lib/auth.config.ts), so this env is OPTIONAL — keep
# it only if you prefer env-driven config. (Previously login broke without it.)
AUTH_TRUST_HOST="true"

# ===== TESTS (required to run the integration suite) =====
# ALOHIDA baza. `test/**/*.test.ts` real yozuv qiladi (User, KassaEntry,
# Payment, LedgerEntry…) — ishchi yoki prod bazaga yugurishi mumkin emas.
# `test/setup.ts` qo'riqchisi buni majburlaydi: nomida "test" bo'lmagan yoki
# uzoq hostdagi bazaga testlar umuman ishga tushmaydi.
#   Tayyorlash:  npm run test:db:setup
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/asro_test?schema=public"

# ===== SECURITY (recommended) =====
# Dedicated key for encrypting ClientCredential passwords (lib/crypto.ts).
# Falls back to AUTH_SECRET if unset, but a separate key is safer.
CREDENTIALS_SECRET=""

# Canonical public site URL for SEO/OpenGraph metadata (app/layout.tsx).
NEXT_PUBLIC_SITE_URL="https://asro.uz"

# ===== TELEGRAM KPI BOT =====
# Bot token from @BotFather. Empty ⇒ sending/polling disabled.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_NAME=""
# Shared secret echoed in X-Telegram-Bot-Api-Secret-Token. REQUIRED in webhook
# mode — the webhook fails closed (503) until this is set.
TELEGRAM_WEBHOOK_SECRET=""
# Bootstrap super-admin Telegram numeric id (can run /bind, /link before linking).
TELEGRAM_ADMIN_TELEGRAM_ID=""
# "webhook" (prod) or "polling" (local dev).
BOT_MODE="webhook"
# Public HTTPS base URL for Telegram Mini App (web_app) buttons and deep links.
# Falls back to AUTH_URL / NEXTAUTH_URL / NEXT_PUBLIC_SITE_URL. Telegram REFUSES
# a web_app button on plain HTTP, so on a local run the button is simply not
# rendered — set this only when you have an https origin.
MINI_APP_URL=""

# ===== QUEUES / CACHE / RATE LIMITING =====
# Redis URL for BullMQ (bot queues) AND the login rate limiter (lib/redis.ts).
# Defaults to redis://127.0.0.1:6379 when unset. Set it to an EMPTY string to
# run without Redis — the login limiter then degrades to a per-process
# in-memory counter (still enforced, but not shared across instances).
REDIS_URL="redis://127.0.0.1:6379"

# ===== AI (optional) =====
# Gemini API key. Powers BOTH the bot message classifier AND the in-app
# "Moliyachi AI" header assistant (web chat). Empty ⇒ both degrade to a
# deterministic heuristic fallback (no outage, lower quality).
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ===== BILLING REMINDERS (optional) =====
BILLING_ENABLED="true"
BILLING_CRON_HOUR="9"

# ===== E-JURNAL ATTENDANCE SYNC (optional) =====
EJURNAL_API_URL=""
EJURNAL_API_TOKEN=""

# ===== ADMIN BOOTSTRAP SCRIPT (scripts/create-admin.ts) =====
# Only needed when running the one-off create-admin script.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Dalil/hujjat fayllari ombori. Bo'sh qoldirilsa ./storage/files ishlatiladi.
# DIQQAT: zaxira ikki qismli — pg_dump + shu katalog (scripts/backup.sh).
ASRO_FILES_ROOT=
