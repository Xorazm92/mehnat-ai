generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  super_admin
  admin
  chief_accountant
  supervisor
  accountant
  bank_manager
}

enum TaxRegime {
  vat
  turnover
  fixed
  yatt
  income
}

enum ReportStatus {
  accepted
  not_submitted
  not_required
  in_progress
  blocked
  error
  unknown
  rejected
  submitted
}

enum StatsType {
  kb1
  micro
  mehnat1
  small
}

enum AuditAction {
  create
  update
  delete
  login
  logout
}

// =====================================================
// USER (replaces Supabase auth.users + profiles)
// =====================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         UserRole  @default(accountant)
  avatarColor  String?   @default("hsl(200, 50%, 50%)")
  phone        String?
  pinfl        String? // JSHSHIR — 14 raqamli shaxsiy identifikatsiya raqami
  department   String?
  gender       String? // 'erkak' | 'ayol'
  birthDate    DateTime?
  education    String? // 'oliy' | 'orta' | 'magistratura'
  skillLevel   String? // malaka darajasi: 'stajyor' | 'orta' | 'tajribali'
  hiredAt      DateTime? // ishga qabul sanasi — ish staji shundan hisoblanadi
  firedAt      DateTime?
  status       String?   @default("active") // 'active' | 'vacation' | 'sick'
  rating       Int?

  // --- Telegram identity (KPI bot ↔ mehnat-ai user mapping) ---
  telegramUserId   BigInt? @unique
  telegramUsername String?
  // `phone` ning oxirgi 9 raqami (lib/phone.ts#phoneKey) — bot `request_contact`
  // orqali kelgan raqamni shu ustun bo'yicha qidiradi. ATAYIN @unique EMAS:
  // prodda dublikat/bo'sh raqamlar bor, migratsiya ular tufayli yiqilmasligi
  // kerak; noaniqlik (2+ mos xodim) ilova qatlamida rad etiladi.
  phoneNormalized  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedCompanies   Company[]            @relation("AccountantCompanies")
  supervisedCompanies Company[]            @relation("SupervisorCompanies")
  chiefCompanies      Company[]            @relation("ChiefAccountantCompanies")
  auditLogs           AuditLog[]
  notifications       Notification[]
  contractAssignments ContractAssignment[]
  performanceRecords  MonthlyPerformance[]
  payrollAdjustments  PayrollAdjustment[]
  kassaEntries        KassaEntry[]
  expenses            Expense[]
  attendances         Attendance[]         @relation("UserAttendance")
  assignedInventory   InventoryItem[]      @relation("UserAssignedInventory")
  payments            Payment[]
  payouts             Payout[]             @relation("EmployeePayouts")
  bankClientCompanies Company[]            @relation("BankClientCompanies")
  chiefDepartments    Department[]         @relation("DepartmentChief")
  statementImports    BankStatementImport[]
  payoutChannels      DisbursementChannel[] @relation("ChannelEmployee")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([phoneNormalized])
}

// =====================================================
// COMPANY
// =====================================================

model Company {
  id                String      @id @default(uuid())
  name              String
  inn               String
  taxRegime         TaxRegime   @default(vat)
  department        String?
  departmentId      String?
  departmentRef     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  accountantId      String?
  accountant        User?       @relation("AccountantCompanies", fields: [accountantId], references: [id], onDelete: SetNull)
  supervisorId      String?
  supervisor        User?       @relation("SupervisorCompanies", fields: [supervisorId], references: [id], onDelete: SetNull)
  chiefAccountantId String?
  chiefAccountant   User?       @relation("ChiefAccountantCompanies", fields: [chiefAccountantId], references: [id], onDelete: SetNull)

  // DEPRECATED — soliq.uz kirish ma'lumoti (ASRO auth EMAS, tashqi xizmat).
  // Ochiq matnda saqlanardi; endi shifrlangan vault'da:
  // ClientCredential(serviceName = "soliq"). Bu ustunlarga YANGI qiymat
  // yozilmaydi (server/companies.ts#sanitizeCompanyData ularni tashlaydi) va
  // ular o'qish yo'lida faqat hali ko'chirilmagan firmalar uchun zaxira sifatida
  // ishlatiladi. Ko'chirish: scripts/migrate-company-credentials.ts
  // Ustunlar ATAYLAB saqlanmoqda — backfill tasdiqlangach alohida sprintda olib tashlanadi.
  login    String?
  password String?

  // Extended fields
  brandName          String?
  directorName       String?
  directorPhone      String?
  legalAddress       String?
  founderName        String?
  bankClientLogin    String?
  bankClientPassword String?
  ownerName      String?
  bankClientId   String?
  bankClient     User?             @relation("BankClientCompanies", fields: [bankClientId], references: [id], onDelete: SetNull)
  bankClientName String?
  statsType      StatsType?
  complexity     CompanyComplexity @default(standard)
  kpiEnabled     Boolean           @default(false)
  serverInfo     String?
  serverName     String?
  baseName1c     String?
  contractAmount Decimal?          @db.Decimal(12, 2)
  contractNumber String?
  contractDate   DateTime?
  paymentDay     Int?

  // Tab 2: SOLIQ
  vatCertificateDate String?
  hasLandTax         Boolean @default(false)
  hasWaterTax        Boolean @default(false)
  hasPropertyTax     Boolean @default(false)
  hasExciseTax       Boolean @default(false)
  oneCStatus         String? // 'cloud' | 'local' | 'server' | 'none'
  oneCLocation       String?

  // Tab 6: XAVF
  companyStatus String? @default("active")
  riskLevel     String? @default("low")
  riskNotes     String?

  // Percentages
  accountantPerc      Decimal? @db.Decimal(5, 2)
  bankClientPerc      Decimal? @db.Decimal(5, 2)
  chiefAccountantPerc Decimal? @db.Decimal(5, 2)
  supervisorPerc      Decimal? @db.Decimal(5, 2)

  // Fixed-sum shares (so'm) — persist explicit amounts from source data
  accountantSum      Decimal? @db.Decimal(12, 2)
  bankClientSum      Decimal? @db.Decimal(12, 2)
  chiefAccountantSum Decimal? @db.Decimal(12, 2)
  supervisorSum      Decimal? @db.Decimal(12, 2)

  // Misc
  requiredReports      String[] // JSON array of report keys
  activeServices       String[] // Active service keys
  itParkResident       String?
  isInternalContractor Boolean  @default(false)
  notes                String?
  isActive             Boolean  @default(true)

  // ASRO'ning O'Z yuridik shaxsi (mijoz emas). Mijozlar to'lovi aynan shu
  // firmalarning bank hisobiga tushadi, shuning uchun ular Company jadvalida
  // turadi — lekin mijozlar ro'yxatiga, qarzdorlikka va payrollga KIRMAYDI.
  isOwnFirm            Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  monthlyReports      MonthlyReport[]
  financialReports    FinancialReport[]
  operations          Operation[]
  contractAssignments ContractAssignment[]
  documents           Document[]
  credentials         ClientCredential[]
  payments            Payment[]
  reportProofs        ReportProof[]
  telegramGroups      TelegramGroup[]
  paymentReminders    PaymentReminder[]
  obligations         Obligation[]
  obligationOverrides CompanyObligationOverride[]
  oneCMappings        OneCCompanyMapping[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  invoices            Invoice[]
  clientUsers         ClientUser[]
  clientRequests      ClientRequest[]
  contracts           Contract[]      @relation("ClientContracts")
  ownFirmContracts    Contract[]      @relation("OwnFirmContracts")
  ownFirmAccounts     BankAccount[]   @relation("OwnFirmAccounts")
  bankTransactions    BankTransaction[]

  @@index([accountantId])
  @@index([supervisorId])
  // Portfel scope'i (lib/access.ts companyScopeWhere) to'rtala mas'ul ustunini
  // ham OR bilan so'raydi — ikkitasi indekssiz qolgan edi.
  @@index([chiefAccountantId])
  @@index([bankClientId])
  @@index([inn])
  @@index([isActive])
  @@index([departmentId])
  @@index([isOwnFirm])
}

// =====================================================
// DEPARTMENT (bo'lim — har bo'lim bir bosh buxgalterga tegishli)
// =====================================================

model Department {
  id                String   @id @default(uuid())
  name              String   @unique
  chiefAccountantId String?
  chiefAccountant   User?    @relation("DepartmentChief", fields: [chiefAccountantId], references: [id], onDelete: SetNull)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companies Company[]

  @@index([chiefAccountantId])
}

// =====================================================
// MONTHLY REPORT (company_monthly_reports)
// =====================================================

model MonthlyReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2025-02"

  // All operation columns
  bankKlient          String?
  didox               String?
  xatlar              String?
  avtokameral         String?
  myMehnat            String?
  oneC                String?
  pulOqimlari         String?
  chiqadiganSoliqlar  String?
  hisoblananOylik     String?
  debitorKreditor     String?
  foydaVaZarar        String?
  tovarOstatka        String?
  ndsBekorQilish      String?
  aylanmaQqs          String?
  daromadSoliq        String?
  inps                String?
  foydaSoliq          String?
  moliyaviyNatija     String?
  buxgalteriyaBalansi String?
  statistika          String?
  bonak               String?
  yerSoligi           String?
  molMulkSoligi       String?
  suvSoligi           String?

  // Statistika 2026
  stat12Invest     String?
  stat12Moliya     String?
  stat12Korxona    String?
  stat12Narx       String?
  stat4Invest      String?
  stat4Mehnat      String?
  stat4KorxonaMiz  String?
  stat4KbQurSavXiz String?
  stat4KbSanoat    String?
  stat1Invest      String?
  stat1Ih          String?
  stat1Energiya    String?
  stat1Korxona     String?
  stat1KorxonaTif  String?
  stat1Moliya      String?
  stat1Akt         String?

  // Qo'shimcha soliqlar / IT Park / Komunalka
  aksizSoligi       String?
  nedroSoligi       String?
  norezidentFoyda   String?
  norezidentNds     String?
  aylanmaQqsTolov   String?
  daromadSoliqTolov String?
  inpsTolov         String?
  foydaSoliqTolov   String?
  itparkOylik       String?
  itparkChorak      String?
  komSuv            String?
  komGaz            String?
  komSvet           String?
  ekologiya         String?

  comment   String?
  updatedAt DateTime @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
}

// =====================================================
// REPORT PROOF (Buxgalter topshirgan skrinshot dalili + nazoratchi tasdig'i)
// Har bir katak = (firma + davr + ustun) uchun bitta joriy dalil.
// =====================================================
model ReportProof {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2026-03"
  colKey    String // OperationModule REPORT_COLUMNS kaliti, masalan "didox"

  imageData String  @db.Text // skrinshot (base64 data URL, klient tomonda siqilgan)
  note      String? // buxgalterning izohi

  status String @default("pending") // pending | approved | rejected

  submittedById   String
  submittedByName String
  submittedAt     DateTime @default(now())

  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  rejectReason   String?

  updatedAt DateTime @updatedAt

  @@unique([companyId, period, colKey])
  @@index([companyId])
  @@index([period])
  @@index([status])
}

// =====================================================
// PAYMENT (Kassa — firma shartnoma to'lovlari, oylik)
// =====================================================

// Moliyaviy hisobot hujjatlari (Foyda/zarar, Balans, QQS, Pul oqimi) — ASRO Hisobotlar moduli
model FinancialReport {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String // 'profit_loss' | 'balance' | 'qqs' | 'cashflow'
  period         String // "2026-H1" | "2026-07"
  status         String    @default("preparing") // preparing | ready | signing | submitted | rejected
  deadline       DateTime?
  assignedTo     String? // employeeId (mas'ul)
  data           Json      @default("{}") // hisobot satrlari (viewer uchun)
  fileFormat     String? // 'PDF' | 'XLS'
  signedBy       String?
  signedAt       DateTime?
  submittedAt    DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([status])
}

model Payment {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period        String // "2026-07"
  amount        Decimal   @db.Decimal(12, 2)
  paymentDate   DateTime?
  status        String    @default("pending") // 'paid' | 'pending' | 'partial' | 'overdue'
  paymentMethod String    @default("naqd") // 'naqd' | 'plastik' | 'schyot' | 'terminal' | 'boshqa'
  comment       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  user          User?     @relation(fields: [createdBy], references: [id])

  // Soft delete — moliyaviy yozuv hech qachon jismonan o'chirilmaydi
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  // Bank vipiskasidan kelgan tranzaksiyalarning shu oylik qatorga taqsimoti.
  // Payment — OYLIK YIG'MA (bir firma / bir davr), allocations esa har bir
  // to'lovni alohida shartnomaga bog'laydi: bitta mijoz oyda uch marta uch xil
  // shartnoma bo'yicha to'lashi mumkin.
  allocations PaymentAllocation[]

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
  @@index([status])
  @@index([deletedAt])
}

// =====================================================
// OPERATION (annual/quarterly reports)
// =====================================================

model Operation {
  id                String       @id @default(uuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period            String // "2024 Yillik"
  profitTaxStatus   ReportStatus @default(not_submitted)
  form1Status       ReportStatus @default(not_submitted)
  form2Status       ReportStatus @default(not_submitted)
  statsStatus       ReportStatus @default(not_submitted)
  comment           String?
  deadlineProfitTax DateTime?
  deadlineStats     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
}

// =====================================================
// KPI RULES (Dynamic KPI system)
// =====================================================

model KpiRule {
  id             String  @id @default(uuid())
  name           String  @unique // Internal: "telegram_response"
  nameUz         String // O'zbekcha: "Telegramda javob"
  role           String // 'accountant' | 'bank_client' | 'supervisor' | 'all'
  rewardPercent  Decimal @db.Decimal(5, 2)
  penaltyPercent Decimal @db.Decimal(5, 2)
  inputType      String // 'checkbox' | 'counter' | 'number' | 'rating'
  category       String // 'attendance', 'telegram', 'reports'
  description    String?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  // --- KPI v2 (uch holatli tizim: bonus / neytral / jarima) ---
  descriptionUz String? // O'zbekcha batafsil izoh
  options       Json     @default("[]") // [{ key, label_uz, color, coeff | coeff_per_unit, max_coeff, note }]
  inputTypeV2   String   @default("select") // 'select' | 'counter' | 'checkbox_bonus' | 'checkbox_penalty' | 'amount_penalty'
  scope         String   @default("global") // 'global' | 'per_company' | 'per_group'
  maxBonus      Decimal? @db.Decimal(6, 2)
  maxPenalty    Decimal? @db.Decimal(6, 2)

  performances MonthlyPerformance[]
  companyRules CompanyKpiRule[]
}

model CompanyKpiRule {
  id             String   @id @default(uuid())
  companyId      String
  ruleId         String
  rule           KpiRule  @relation(fields: [ruleId], references: [id])
  rewardPercent  Decimal? @db.Decimal(5, 2)
  penaltyPercent Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)

  @@unique([companyId, ruleId])
}

// =====================================================
// MONTHLY PERFORMANCE (KPI entries)
// =====================================================

model MonthlyPerformance {
  id                     String    @id @default(uuid())
  month                  String // '2026-02-01'
  companyId              String
  employeeId             String
  employee               User      @relation(fields: [employeeId], references: [id])
  ruleId                 String
  rule                   KpiRule   @relation(fields: [ruleId], references: [id])
  value                  Decimal   @db.Decimal(10, 2)
  calculatedScore        Decimal   @db.Decimal(10, 2)
  rewardPercentOverride  Decimal?  @db.Decimal(5, 2)
  penaltyPercentOverride Decimal?  @db.Decimal(5, 2)
  // --- KPI v2 kirish maydonlari ---
  selectedOption         String? // Nazoratchi tanlagan option key (green/yellow/red holati)
  earlyDays              Int       @default(0) // 08:30 gacha kelgan kunlar (bonus counter)
  lateMinutes            Int       @default(0) // Kechikkan daqiqalar (counter qoidalar uchun)
  absentDays             Int       @default(0) // Uzrsiz kelmagan kunlar soni
  penaltyAmount          Decimal   @default(0) @db.Decimal(12, 2) // Qo'lda kiritilgan jarima summasi (amount_penalty)
  source                 String? // 'employee' | 'supervisor' | 'chief' | 'system'
  status                 String    @default("draft")
  submittedBy            String?
  submittedAt            DateTime?
  approvedBy             String?
  approvedAt             DateTime?
  rejectedReason         String?
  notes                  String?
  changeReason           String?
  recordedAt             DateTime  @default(now())

  // One Monthly Performance per rule, per employee, per Company, per month.
  // Payroll sums every approved row and penalties are uncapped, so a duplicate
  // is not a cosmetic issue — it multiplies a penalty into someone's salary.
  // See ADR-0004 and ADR-0001.
  @@unique([month, companyId, employeeId, ruleId])
  @@index([employeeId])
  @@index([companyId])
  @@index([month])
}

// =====================================================
// PAYROLL ADJUSTMENT
// =====================================================

// MAJBURIYAT qatlami: hisoblangan oylik ('payment'), avans, jarima, bonus.
// REAL pul berish alohida Payout jadvalida — majburiyat ≠ to'lov (ERP ajratuvi).
model PayrollAdjustment {
  id             String    @id @default(uuid())
  month          String
  employeeId     String
  employee       User      @relation(fields: [employeeId], references: [id])
  companyId      String?
  adjustmentType String // 'bonus' | 'avans' | 'jarima' | 'payment' | 'manual' | 'other'
  amount         Decimal   @db.Decimal(12, 2)
  reason         String
  approvedBy     String?
  approvedAt     DateTime?
  isApproved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  createdBy      String?

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  payouts Payout[]

  @@index([employeeId, month])
  @@index([deletedAt])
}

// =====================================================
// PAYOUT — REAL berilgan pul (majburiyatdan ajratilgan)
// =====================================================
// PayrollAdjustment "qancha to'lash kerak"ni aytadi; Payout "qancha, qachon,
// kim tomonidan, qanday usulda haqiqatan berildi"ni yozadi. Balans/cashflow
// faqat Payout'ni chiqim deb sanaydi. adjustmentId — majburiyat havolasi
// (tasdiqlangan 'payment'/'avans' qatori).
model Payout {
  id            String             @id @default(uuid())
  employeeId    String
  employee      User               @relation("EmployeePayouts", fields: [employeeId], references: [id])
  companyId     String?
  adjustmentId  String?
  adjustment    PayrollAdjustment? @relation(fields: [adjustmentId], references: [id])
  month         String // "YYYY-MM" — qaysi oy majburiyati uchun
  amount        Decimal            @db.Decimal(12, 2) // har doim musbat
  paymentMethod String             @default("naqd") // 'naqd' | 'plastik' | 'schyot' | 'terminal' | 'boshqa'
  note          String?
  paidAt        DateTime           @default(now())
  createdBy     String?
  createdAt     DateTime           @default(now())

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([employeeId, month])
  @@index([adjustmentId])
  @@index([paidAt])
  @@index([deletedAt])
}

// =====================================================
// DOUBLE-ENTRY LEDGER — har harakat ikki tomonlama
// =====================================================
// Append-only: yozuv hech qachon o'zgartirilmaydi/o'chirilmaydi; tuzatish
// faqat reversal (teskari) entry orqali. transactionId ikki oyoqni bog'laydi;
// har tranzaksiyada Σdebit == Σcredit (lib/ledger.ts kafolatlaydi).
model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String // lib/ledger.ts ACCOUNTS: CASH | CONTRACT_INCOME | KASSA_INCOME | OPERATING_EXPENSE | SALARY_EXPENSE
  debit         Decimal  @default(0) @db.Decimal(14, 2)
  credit        Decimal  @default(0) @db.Decimal(14, 2)
  description   String?
  sourceTable   String? // Expense | KassaEntry | Payment | Payout (+ '-reversal')
  sourceId      String?
  period        String // "YYYY-MM"
  createdAt     DateTime @default(now())
  createdBy     String?

  @@index([transactionId])
  @@index([accountId, period])
  @@index([sourceTable, sourceId])
  @@index([period])
}

// =====================================================
// ACCOUNTING PERIOD — oy yopilishi holat mashinasi
// =====================================================
// Statuslar: OPEN → READY_TO_CLOSE → CLOSING → LOCKED → (REOPENED) → CLOSING...
// FAILED = oxirgi yopish urinishi checklist/xato bilan yiqilgan (yozish ochiq).
// LOCKED va CLOSING davrlarga hech qanday moliyaviy mutation kirmaydi
// (lib/periodLock.ts). companyId null = butun firma (global). Global (year,month)
// yagona — migratsiyadagi partial unique index bilan (Postgres NULL-unique).
model AccountingPeriod {
  id        String    @id @default(uuid())
  companyId String? // null = global
  year      Int
  month     Int // 1-12
  status    String    @default("OPEN") // OPEN | READY_TO_CLOSE | CLOSING | LOCKED | REOPENED | FAILED
  lockedBy  String?
  lockedAt  DateTime?

  // Month-end closing metadata
  openingBalance Decimal?  @db.Decimal(14, 2) // yopilganda / keyingi oy yaratilganda to'ldiriladi
  closedBy       String?
  closedAt       DateTime?
  reopenedBy     String?
  reopenedAt     DateTime?
  reopenReason   String?
  statusNote     String? // FAILED sababi (checklist xatolari qisqartmasi)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year, month])
  @@index([year, month])
  @@index([status])
}

// =====================================================
// FINANCIAL SNAPSHOT — davr yopilishi qoldiqlari (IMMUTABLE)
// =====================================================
// period = "YYYY-MM" (oy yopilishi) yoki "YYYY" (yil yopilishi).
// closingBalance = openingBalance + income − outflow.
// IMMUTABLE: moliyaviy ustunlar DB-darajali trigger bilan qulflangan
// (migratsiya financial_snapshot_immutable) — faqat isValid/invalidated*
// belgilarini o'zgartirish mumkin (reopen invalidatsiyasi). Global period
// yagona — partial unique index bilan.
model FinancialSnapshot {
  id             String  @id @default(uuid())
  companyId      String? // null = butun firma
  period         String // "2026-01" | "2026"
  openingBalance Decimal @db.Decimal(14, 2)
  closingBalance Decimal @db.Decimal(14, 2)
  income         Decimal @default(0) @db.Decimal(14, 2)
  outflow        Decimal @default(0) @db.Decimal(14, 2)

  // Month-end kengaytmasi
  payrollTotal  Decimal @default(0) @db.Decimal(14, 2) // oy ichida berilgan oyliklar (Payout)
  cashIn        Decimal @default(0) @db.Decimal(14, 2) // ledger CASH debit (davr)
  cashOut       Decimal @default(0) @db.Decimal(14, 2) // ledger CASH credit (davr)
  ledgerBalance Decimal @default(0) @db.Decimal(14, 2) // yopilish paytidagi ledger CASH qoldig'i
  profit        Decimal @default(0) @db.Decimal(14, 2) // max(0, income − outflow)
  loss          Decimal @default(0) @db.Decimal(14, 2) // max(0, outflow − income)
  employeeCount Int     @default(0)
  companyCount  Int     @default(0)
  checksum      String? // sha256 — moliyaviy maydonlar ustidan (lib/snapshot.ts)

  // Reopen invalidatsiyasi (trigger ruxsat bergan yagona o'zgarish)
  isValid       Boolean   @default(true)
  invalidatedAt DateTime?
  invalidatedBy String?
  invalidReason String?

  createdBy String?
  createdAt DateTime @default(now())

  @@unique([companyId, period])
  @@index([period])
  @@index([isValid])
}

// =====================================================
// CONTRACT ASSIGNMENT
// =====================================================

model ContractAssignment {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String // 'accountant' | 'controller' | 'bank_manager' | 'chief' | 'chief_accountant'
  salaryType  String // 'percent' | 'fixed'
  salaryValue Decimal   @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([userId])
  // Scope'dagi `contractAssignments: { some: { userId, isActive } }` uchun.
  @@index([userId, isActive])
}

// =====================================================
// CLIENT CREDENTIALS
// =====================================================

model ClientCredential {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceName       String // 'soliq' | 'didox' | 'my_mehnat' | 'bank_client'
  loginId           String
  encryptedPassword String
  keyFilePath       String?
  notes             String?
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  // Firmalar ro'yxati har yuklanishda asosiy (soliq) credential'ni shu bo'yicha
  // qidiradi — companyId IN (…) AND serviceName = 'soliq'.
  @@index([companyId, serviceName])
}

// =====================================================
// KASSA
// =====================================================

model KassaEntry {
  id          String   @id @default(uuid())
  companyId   String?
  type        String // 'income' | 'expense'
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id])

  // Pul qaysi kanal orqali chiqdi/kirdi: o'z bank hisobi, naqd, plastik yoki
  // o'zini-o'zi band qilgan xodimning kartasi. FK emas — mavjud `companyId`
  // uslubiga mos (kanal o'chirilsa tarixiy yozuv yo'qolmasin).
  channelId String?

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([date])
  @@index([type])
  @@index([deletedAt])
  @@index([companyId])
  @@index([channelId])
}

// =====================================================
// EXPENSE
// =====================================================

model Expense {
  id             String    @id @default(uuid())
  amount         Decimal   @db.Decimal(12, 2)
  date           DateTime
  category       String
  paymentMethod  String    @default("naqd") // 'naqd' | 'plastik' | 'schyot' | 'terminal' | 'boshqa'
  description    String?
  // Tasdiqlash oqimi: <1mln avto, 1-10mln Bosh Buxgalter, >10mln + Superadmin
  status         String    @default("pending") // pending | approved | rejected
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  createdBy      String?
  user           User?     @relation(fields: [createdBy], references: [id])

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([date])
  @@index([category])
  @@index([status])
  @@index([deletedAt])
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  tableName String
  recordId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([tableName])
  @@index([createdAt])
}

// =====================================================
// NOTIFICATION
// =====================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'deadline' | 'status_change' | 'kpi_alert' | 'system' | 'approval_request'
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// =====================================================
// DOCUMENT
// =====================================================

model Document {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  filePath   String
  fileSize   Int?
  mimeType   String?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([companyId])
}

// =====================================================
// ATTENDANCE & INVENTORY
// =====================================================

model Attendance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("present") // present, absent, late, excused
  notes       String?
  source      String?   @default("manual") // 'manual' | 'ejurnal' — where the record came from
  lateMinutes Int?      @default(0) // minutes the check-in is past the 09:00 threshold
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // `date` is always stored at UTC midnight (both writers build it from a
  // "YYYY-MM-DD" string), so one row per person per day. Without this, a repeated
  // e-jurnal sync doubles earlyDays and pays a bonus that was never earned.
  @@unique([userId, date])
  @@index([date])
}

// Kim kimning o'rniga ishladi. Reglament: uzrsiz kelmagan kun uchun yechilgan pul
// o'sha kuni ishni bajargan xodimga o'tadi (ta'tilda — 50%).
model ShiftCover {
  id           String   @id @default(uuid())
  date         DateTime
  absentUserId String
  coverUserId  String
  companyId    String?
  kind         String // 'absence' | 'vacation'
  approvedById String?
  note         String?
  createdAt    DateTime @default(now())

  // NO @@unique here on purpose. Postgres treats NULLs as distinct, so
  // @@unique([date, absentUserId, companyId]) would happily accept two firm-wide
  // (companyId = NULL) covers for the same day and pay the substitute twice.
  // The migration installs two PARTIAL unique indexes instead — one for
  // companyId IS NOT NULL, one for IS NULL. Prisma cannot express those.
  @@index([coverUserId])
  @@index([date, absentUserId])
}

model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  serialNumber String?  @unique
  status       String   @default("available") // available, assigned, maintenance, retired
  condition    String   @default("good")
  assignedToId String?
  assignedTo   User?    @relation("UserAssignedInventory", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
}

// =====================================================
// SYSTEM SETTING (global admin-managed key/value config)
// =====================================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

// =====================================================
// TELEGRAM KPI BOT
// Signal-capture + question/answer + immutable KPI ledger.
// The bot writes here; the existing KPI engine (KpiRule /
// MonthlyPerformance / PayrollAdjustment) and dashboards read it.
// See KPI_BOT_BLUEPRINT.md and bot/README.md.
// =====================================================

// Firma ↔ Telegram guruh. One company may map to several chats.
model TelegramGroup {
  id        String   @id @default(uuid())
  chatId    BigInt   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Idempotency ledger: Telegram delivers at-least-once, so each update_id is
// processed exactly once. The webhook/worker upserts here before doing work.
model ProcessedUpdate {
  updateId    BigInt   @id
  processedAt DateTime @default(now())

  @@index([processedAt]) // for periodic cleanup of old dedup rows
}

// Full message capture (text / reply / edit / delete / reaction / media / voice).
// No @@unique([chatId, messageId]): edits & reactions are appended as separate
// rows (message history), and dedup is guaranteed upstream by ProcessedUpdate.
model TelegramMessage {
  id              String   @id @default(uuid())
  updateId        BigInt? // source Telegram update_id (trace)
  chatId          BigInt
  messageId       BigInt
  fromUserId      BigInt? // Telegram numeric id of the sender
  userId          String? // mapped mehnat-ai User id, when known
  text            String?  @db.Text
  kind            String // 'text'|'reply'|'edit'|'delete'|'reaction'|'media'|'voice'|'file'
  replyToId       BigInt?
  mediaType       String?
  fileId          String? // Telegram file_id — chek/skrinshotni keyin yuklab olish uchun
  voiceTranscript String?  @db.Text // STT result
  createdAt       DateTime // Telegram message time
  loggedAt        DateTime @default(now()) // when the bot captured it

  @@index([chatId, createdAt]) // scale / future partitioning key
  @@index([chatId, messageId]) // reply resolution
  @@index([userId, createdAt])
}

// Question state machine. Deadline = ResponseWindow × WorkingHours (domain layer).
model Question {
  id                String    @id @default(uuid())
  chatId            BigInt
  companyId         String?
  messageId         BigInt
  askedByUserId     BigInt?
  text              String?   @db.Text
  responsibleRole   String // 'accountant'|'bank_client'|'controller'
  responsibleUserId String? // resolved mehnat-ai User, when known
  status            String    @default("pending") // pending|answered|late|closed
  deadlineAt        DateTime
  answeredAt        DateTime?
  aiConfidence      Decimal?  @db.Decimal(4, 3) // AI classifier confidence 0.000–1.000
  createdAt         DateTime  @default(now())
  answers           Answer[]

  @@index([status, deadlineAt]) // critical for the pending-only deadline sweep
  @@index([companyId])
  @@index([chatId, messageId])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  byUserId   String?
  messageId  BigInt
  createdAt  DateTime @default(now())

  @@index([questionId])
}

// Immutable KPI ledger — every bonus/penalty is a signed, append-only row.
// Rolled up into MonthlyPerformance; never mutated (corrections = new rows).
model KpiEvent {
  id          String   @id @default(uuid())
  employeeId  String // mehnat-ai User id
  companyId   String?
  ruleId      String? // which KpiRule was applied
  periodMonth String // "2026-07"
  type        String // 'response'|'attendance'|'report'|'manual'
  points      Decimal  @db.Decimal(10, 4) // signed: + bonus / − penalty
  sourceRef   String? // Question.id / Attendance.id / ...
  meta        Json     @default("{}")
  createdBy   String? // for manual adjustments: who
  createdAt   DateTime @default(now())

  @@index([employeeId, periodMonth])
  @@index([companyId, periodMonth])
  @@index([periodMonth])
}

// Escalation delivery record (🟡🟠🔴) for a Notification over a channel.
model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String?
  channel        String // 'telegram'|'inapp'
  level          String // 'yellow'|'orange'|'red'
  targetChatId   BigInt?
  status         String    @default("pending") // pending|sent|failed
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  // Idempotency: obligation reminders write a stable dedupKey so a repeated
  // sweep never re-sends. NULL keys stay distinct (legacy/non-deduped rows).
  // e.g. "obligation:<id>:reminder:D-5" | ":due" | ":overdue:L1"
  dedupKey    String?
  recipientId String?

  @@unique([channel, dedupKey])
  @@index([status])
}

// Payment-reminder trail. @@unique([companyId, period, level]) makes each
// escalation step fire once per company+period — no spam, restart-safe.
model PaymentReminder {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2026-07" (matches Payment.period)
  level     String // 'yellow'|'orange'|'red'
  amountDue Decimal  @db.Decimal(12, 2) // debt at reminder time
  chatId    BigInt? // which group it was sent to
  status    String   @default("sent") // sent|failed|skipped
  sentAt    DateTime @default(now())

  @@unique([companyId, period, level])
  @@index([period])
  @@index([status])
}

// =====================================================
// COMPLIANCE / DEADLINE ENGINE (Faza A)
// Har mijoz uchun takrorlanuvchi majburiyatlarni avtomatik yaratadi,
// muddat/eskalatsiya, kechikish sababi (2-bosqichli), submission+evidence.
// TAMOYIL: ish-jarayoni holati (status) va muddatga rioya (isOverdue,
// hisoblanadi) — ikki alohida o'lcham. Enum qiymatlari mavjud schema idiomiga
// mos: kichik harf snake_case (qarang ReportStatus).
// =====================================================

enum ObligationStatus {
  planned
  in_progress
  ready
  sent
  accepted
  rejected
  cancelled
}

enum SubmissionStatus {
  sent
  accepted
  rejected
}

enum EvidenceType {
  screenshot
  pdf
  receipt
  external_reference // tashqi tizim ID (masalan 1C hujjat/kvitansiya ID)
  api_response // integratsiya javobi
  manual_approval // vakolatli reviewer tasdig'i
}

enum DelayReason {
  accountant_delay
  client_delay
  system_failure
  external_authority
  management_decision
  other
}

enum Periodicity {
  monthly
  quarterly
  annual
}

enum DeadlineAnchorType {
  period_end_offset // davr tugashidan +N kun
  fixed_day_of_month // muayyan oy-kuni
}

enum WorkdayAdjustmentPolicy {
  none
  next_workday
  previous_workday
}

enum TemplateLifecycle {
  draft
  approved
  active
  retired
}

// Takrorlanuvchi majburiyat qoidasi (versionlangan, tasdiqlanadigan).
// Qoida o'zgarsa — YANGI versiya; eski majburiyatlar templateVersion snapshoti
// bilan tarixda qoladi. Admin darhol productionga chiqara olmaydi (lifecycle).
model DeadlineTemplate {
  id             String             @id @default(uuid())
  code           String // barqaror kalit, masalan "QQS_DECLARATION"
  name           String
  obligationType String // erkin turkum, masalan "tax_declaration" | "statistics"
  periodicity    Periodicity
  anchorType     DeadlineAnchorType
  dueDay         Int? // fixed_day_of_month uchun (1..31)
  dueMonth       Int? // annual/quarterly fixed uchun (1..12)
  offsetDays     Int? // period_end_offset uchun

  adjustmentPolicy WorkdayAdjustmentPolicy @default(next_workday)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  version       Int       @default(1)

  lifecycle    TemplateLifecycle @default(draft)
  active       Boolean           @default(true)
  approvedById String?
  approvedAt   DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicability TemplateApplicability[]
  overrides     CompanyObligationOverride[]
  obligations   Obligation[]

  @@unique([code, version])
  @@index([lifecycle])
  @@index([active])
  @@index([obligationType])
}

// Template kompaniyaga tegishlimi — faqat taxRegime emas. Bir template →
// bir nechta kriteriya (AND semantikasi kod tomonda aniqlanadi).
model TemplateApplicability {
  id            String           @id @default(uuid())
  templateId    String
  template      DeadlineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteriaType  String // tax_regime|vat_payer|has_employees|stats_type|service_key|company_status
  criteriaValue String
  createdAt     DateTime         @default(now())

  @@unique([templateId, criteriaType, criteriaValue])
  @@index([templateId])
}

// Kompaniya darajasidagi istisno: majburiyatni o'chirish / individual deadline /
// boshqa mas'ul. Generator shu overridega bo'ysunadi.
model CompanyObligationOverride {
  id         String           @id @default(uuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId String
  template   DeadlineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  action            String // disable | custom_due | reassign
  customDueDay      Int?
  customOffsetDays  Int?
  responsibleUserId String?
  reason            String

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, templateId])
  @@index([companyId])
}

// Ish/dam olish/bayram kalendari — dueAt ni ish kuniga surish uchun.
// UTC saqlanadi; biznes hisobi Asia/Tashkent. Tasdiqlangan to'plam.
model BusinessCalendarDay {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  isWorkday    Boolean  @default(true)
  isHoliday    Boolean  @default(false)
  name         String?
  approvedById String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([isWorkday])
}

// Muayyan kompaniya+template+davr uchun aniq majburiyat.
// status = ish-jarayoni; isOverdue = (dueAt < now AND status NOT IN
// (accepted, cancelled)) — HISOBLANADI, saqlanmaydi.
model Obligation {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId      String
  template        DeadlineTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion Int // snapshot: qaysi template versiyasi bilan yaratilgan

  periodStart DateTime
  periodEnd   DateTime
  periodKey   String // UI: "2026-M07" | "2026-Q3" | "2026-Y"
  dueAt       DateTime

  status ObligationStatus @default(planned)

  // Mas'ul SNAPSHOT (assignment keyin o'zgarsa ham tarix yo'qolmaydi)
  responsibleUserId String?
  backupUserId      String?
  assignedAt        DateTime?
  assignedById      String?

  // Timing belgilari
  sentAt         DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?
  firstOverdueAt DateTime?

  // Kechikish sababi — 2 bosqichli: belgilangan + MANAGER tasdiqlagan.
  // KPI exclusion faqat delayApprovedById mavjud + dalilli bo'lsa.
  delayReason       DelayReason?
  delayComment      String?
  delayMarkedById   String?
  delayMarkedAt     DateTime?
  delayApprovedById String?
  delayApprovedAt   DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      ObligationSubmission[]
  statusEvents     ObligationStatusEvent[]
  assignmentEvents ObligationAssignmentEvent[]

  @@unique([companyId, templateId, periodStart, periodEnd])
  @@index([companyId])
  @@index([status])
  @@index([dueAt])
  @@index([responsibleUserId])
  @@index([periodKey])
}

// Status o'zgarishi tarixi (KPI/timeline uchun; AuditLogdan tashqari, so'rovga qulay).
model ObligationStatusEvent {
  id           String            @id @default(uuid())
  obligationId String
  obligation   Obligation        @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  fromStatus   ObligationStatus?
  toStatus     ObligationStatus
  byUserId     String?
  note         String?
  at           DateTime          @default(now())

  @@index([obligationId])
}

// Mas'ul biriktirish o'zgarishi tarixi.
model ObligationAssignmentEvent {
  id           String     @id @default(uuid())
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  fromUserId   String?
  toUserId     String?
  byUserId     String?
  reason       String?
  at           DateTime   @default(now())

  @@index([obligationId])
}

// Bir majburiyat → ko'p yuborish urinishi (yubordi→rad→tuzatdi→qayta→qabul).
// externalId/sourceSystem — Faza B 1C integratsiyasi uchun oldindan tayyor.
model ObligationSubmission {
  id           String           @id @default(uuid())
  obligationId String
  obligation   Obligation       @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  attemptNo    Int
  status       SubmissionStatus @default(sent)

  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectionCode String?
  rejectionNote String?

  externalId   String? // tashqi tizim ID (1C/soliq)
  sourceSystem String? // "asro" | "1c" | ...

  createdById String?
  createdAt   DateTime @default(now())

  evidence SubmissionEvidence[]

  @@unique([obligationId, attemptNo])
  @@index([obligationId, status])
  @@index([externalId])
}

// Yuborish dalili. storageRef = private storage yo'li/URL/tashqi ID (base64 EMAS).
// Mavjud ReportProof bridge qilinadi (legacy → attempt #1, type=screenshot).
// MUHIM: screenshot yoki ichki approval avtomatik "soliq qabul qildi" EMAS —
// accepted uchun manba (external_reference/receipt/api_response/manual_approval).
model SubmissionEvidence {
  id           String               @id @default(uuid())
  submissionId String
  submission   ObligationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         EvidenceType
  storageRef   String
  note         String?
  createdById  String?
  createdAt    DateTime             @default(now())

  @@index([submissionId])
}

// =====================================================
// 1C INTEGRATION LAYER (Faza B — pilot, 1C→ASRO one-way)
// =====================================================
// USULDAN MUSTAQIL ASRO-tomon ingest: outbound sync-agent 1C'ni ichki tarmoqda
// o'qiydi (OData/HTTP-service/export — auditda tanlanadi) va ASRO'ga POST qiladi.
// IntegrationEvent — xom payload ledgeri (idempotencyKey bilan dublikatsiz);
// SyncRun — bir batch; SyncError — dead-letter. Domain mapping (payload → ASRO)
// discovery'dan keyin `applyIntegrationEvent` seam'ida to'ldiriladi.

enum IntegrationEventStatus {
  received
  processing
  processed
  failed
  dead // DLQ — attemptlar tugadi
}

enum SyncRunStatus {
  running
  completed
  failed
}

// Agent ro'yxati — har firma/baza uchun bitta ulanish + token (hash saqlanadi).
model OneCConnection {
  id         String    @id @default(uuid())
  name       String
  tokenHash  String    @unique // sha256(token) — plaintext saqlanmaydi
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  mappings OneCCompanyMapping[]
  events   IntegrationEvent[]
  syncRuns SyncRun[]

  @@index([active])
}

// 1C tashkilot (externalOrgId: INN yoki 1C GUID) → ASRO Company.
model OneCCompanyMapping {
  id            String         @id @default(uuid())
  connectionId  String
  connection    OneCConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalOrgId String // 1C tomonidagi tashkilot identifikatori
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@unique([connectionId, externalOrgId])
  @@index([companyId])
}

// Xom kirish hodisasi — idempotent ledger. status DLQ oqimini boshqaradi.
model IntegrationEvent {
  id             String                 @id @default(uuid())
  connectionId   String
  connection     OneCConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncRunId      String?
  syncRun        SyncRun?               @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  sourceSystem   String                 @default("1c")
  eventType      String // masalan "report_status" | "doc_count" | "org"
  externalId     String? // 1C hujjat/obyekt ID
  schemaVersion  Int                    @default(1)
  idempotencyKey String                 @unique // agent bergan barqaror kalit
  occurredAt     DateTime // 1C'da sodir bo'lgan vaqt
  receivedAt     DateTime               @default(now())
  payload        Json
  payloadHash    String // sha256(payload) — reconciliation uchun
  status         IntegrationEventStatus @default(received)
  attempts       Int                    @default(0)
  lastError      String?
  createdAt      DateTime               @default(now())

  @@index([status])
  @@index([connectionId])
  @@index([externalId])
  @@index([eventType])
}

// Bir agent batch'i — qamrov va reconciliation.
model SyncRun {
  id              String         @id @default(uuid())
  connectionId    String
  connection      OneCConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status          SyncRunStatus  @default(running)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  eventsReceived  Int            @default(0)
  eventsProcessed Int            @default(0)
  eventsFailed    Int            @default(0)
  cursor          String? // keyingi sync uchun kursor (agent beradi)
  createdAt       DateTime       @default(now())

  events IntegrationEvent[]

  @@index([connectionId])
  @@index([status])
}

// Dead-letter / qayta-ishlash xatolari.
model SyncError {
  id                 String   @id @default(uuid())
  integrationEventId String?
  syncRunId          String?
  connectionId       String?
  message            String
  detail             Json?
  createdAt          DateTime @default(now())

  @@index([integrationEventId])
  @@index([connectionId])
}

// =====================================================
// WORK MANAGEMENT + SLA (Faza C1)
// =====================================================
// In-app vazifalar (bot Question SLA patternidan ilhomlangan): javob (response)
// va yechim (resolution) SLA'lari. SLA faqat yakuniy muddat emas — masalan
// "mijoz hujjat yuborgach 8 soatda ko'rilishi kerak" (reviewer). Breach sweep
// SlaBreach yozadi (dedup: @@unique([taskId, breachType])).

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum SlaBreachType {
  response // birinchi javob kechikdi
  resolution // yakunlash kechikdi
}

// Nomlangan SLA siyosati — taskType bo'yicha (null = default).
model SlaPolicy {
  id                String   @id @default(uuid())
  name              String
  taskType          String? // qaysi vazifa turiga (null = default)
  responseMinutes   Int? // birinchi javobgacha ruxsat etilgan vaqt
  resolutionMinutes Int? // yakunlashgacha
  businessHoursOnly Boolean  @default(false) // TODO: biznes-soat hisobi (kalendar)
  active            Boolean  @default(true)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tasks    Task[]
  breaches SlaBreach[]

  @@index([taskType])
  @@index([active])
}

// Ish/vazifa. companyId ixtiyoriy (ichki vazifa ham bo'ladi).
model Task {
  id             String       @id @default(uuid())
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  taskType       String?
  priority       TaskPriority @default(normal)
  status         TaskStatus   @default(open)
  assigneeUserId String?
  createdBy      String?
  dueAt          DateTime?

  // SLA — yaratishda siyosatdan hisoblanadi.
  slaPolicyId     String?
  slaPolicy       SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime? // birinchi harakat (assign yoki in_progress)

  startedAt     DateTime?
  completedAt   DateTime?
  blockerReason String?
  reworkReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   TaskEvent[]
  breaches SlaBreach[]

  @@index([companyId])
  @@index([assigneeUserId])
  @@index([status])
  @@index([dueAt])
}

// Status/assignment/comment tarixi.
model TaskEvent {
  id         String      @id @default(uuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type       String // status | assign | comment
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  fromUserId String?
  toUserId   String?
  note       String?
  byUserId   String?
  at         DateTime    @default(now())

  @@index([taskId])
}

// SLA buzilishi — dedup: har task+breachType bir marta.
model SlaBreach {
  id          String        @id @default(uuid())
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  slaPolicyId String?
  slaPolicy   SlaPolicy?    @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  breachType  SlaBreachType
  dueAt       DateTime
  breachedAt  DateTime      @default(now())

  @@unique([taskId, breachType])
  @@index([taskId])
}

// =====================================================
// TIME TRACKING + EMPLOYEE COST (Faza C2 — rentabellik kirish sharti)
// =====================================================
// Mehnat vaqti (TimeEntry) + xodim to'liq soatlik qiymati (EmployeeCostRate,
// effective-dated). Mehnat tannarxi = daqiqa/60 × sanadagi amaldagi stavka —
// Faza D contribution margin uchun. Reviewer #18 (task modulga qattiq bog'lanmaydi).

enum TimeSource {
  manual // qo'lda kiritilgan
  timer // sekundomer
  estimate // task asosida taxmin
  normative // standart normativ vaqt
}

model TimeEntry {
  id           String     @id @default(uuid())
  userId       String // xodim (aktor-id konvensiyasi — relationsiz)
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  taskId       String? // ixtiyoriy — Task/Obligation'ga bog'lash (relationsiz)
  obligationId String?
  date         DateTime   @db.Date
  minutes      Int
  activityType String?
  note         String?
  source       TimeSource @default(manual)
  createdBy    String?
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([date])
  @@index([taskId])
}

// Xodimning to'liq soatlik qiymati — versionlangan (effective-dated). Tarixiy
// TimeEntry o'z sanasidagi stavka bilan hisoblanadi.
model EmployeeCostRate {
  id            String    @id @default(uuid())
  userId        String
  hourlyRate    Decimal   @db.Decimal(12, 2) // to'liq: oylik + soliq + overhead ulushi
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([userId, effectiveFrom])
}

// =====================================================
// BILLING (Faza D — invoice + qarzdorlik)
// =====================================================
// Invoice = mijozga chiqarilgan hisob; Payment (mavjud) = kelgan to'lov.
// Qarzdorlik = chiqarilgan (sent/overdue) − to'langan. Rentabellik hisob-kitobi
// server/profitability.ts'da (Payment tushum − mehnat tannarxi).

enum InvoiceStatus {
  draft
  sent
  partial
  paid
  overdue
  void
}

model Invoice {
  id         String        @id @default(uuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period     String // "2026-07"
  amount     Decimal       @db.Decimal(12, 2)
  paidAmount Decimal       @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus @default(draft)
  issuedAt   DateTime?
  dueAt      DateTime?
  notes      String?
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Soft delete — moliyaviy yozuv jismonan o'chirilmaydi.
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([companyId])
  @@index([period])
  @@index([status])
  @@index([deletedAt])
}

// =====================================================
// FAIR KPI v2 (Faza E — shadow mode)
// =====================================================
// Mavjud KpiEvent/MonthlyPerformance'ga TEGMAYDI — parallel adolatli qatlam.
// Weighted composite (SLA 35 / Quality 25 / Client 15 / Volume 15 / Discipline
// 10), complexity-normalized volume, delay-reason exclusion (Faza A tasdiqlangan
// sabab). shadowMode=true → oylikka ta'sir qilmaydi (2-3 oy kuzatuv). Reviewer.

enum CompanyComplexity {
  simple
  standard
  complex
  enterprise
}

// Xodim × davr uchun hisoblangan shadow ball (komponentlar bilan — shaffoflik).
model FairKpiScore {
  id         String @id @default(uuid())
  period     String // "2026-07"
  employeeId String

  sla        Decimal @db.Decimal(5, 2) // 0-100
  quality    Decimal @db.Decimal(5, 2)
  client     Decimal @db.Decimal(5, 2)
  volume     Decimal @db.Decimal(5, 2)
  discipline Decimal @db.Decimal(5, 2)
  composite  Decimal @db.Decimal(5, 2)

  volumePoints Decimal @default(0) @db.Decimal(8, 2) // complexity-weighted hajm
  shadowMode   Boolean @default(true)
  note         String?

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([period, employeeId])
  @@index([period])
  @@index([employeeId])
}

// =====================================================
// CLIENT PORTAL (Faza F — mijoz kabineti)
// =====================================================
// Alohida auth identity (staff User'dan ajratilgan). Mijoz FAQAT o'z firmasini
// ko'radi (companyId izolyatsiya). Reviewer: ichki jarayonlar ishonchli bo'lgach.

model ClientUser {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

// Mijoz murojaati (ticket).
model ClientRequest {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientUserId String?
  subject      String
  message      String
  status       String    @default("open") // open | answered | closed
  responseText String?
  respondedBy  String? // staff user id
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
}

// =====================================================
// BANK VIPISKA IMPORTI VA SHARTNOMALAR
// =====================================================
//
// BALANS IKKI MARTA SANALMASLIGI — asosiy qoida.
// lib/balance.ts da kirim = Payment(paid|partial) + KassaEntry(income).
// Shuning uchun:
//   * BankTransaction — XOM, o'zgarmas yozuv; balansga UMUMAN kirmaydi.
//   * Mijozga moslashtirilgan bank KIRIMI  → Payment (+ PaymentAllocation).
//   * Mijozsiz kirim, naqd, plastik        → KassaEntry(income).
//   * Bank CHIQIMI (soliq/ijara/aloqa/...) → KassaEntry(expense).
//   * Oylik va xodim kartasiga o'tkazma    → avtomatik YOZILMAYDI; Payout
//     bilan bog'lash taklif qilinadi (aks holda chiqim ikki marta sanaladi).

/// O'z firmaning bank hisobi. Vipiska aynan shu hisob nomiga tortiladi.
model BankAccount {
  id             String  @id @default(uuid())
  accountNumber  String  @unique // "20208000600767792001"
  mfo            String?
  bankName       String?
  /// Hisob egasi — isOwnFirm = true bo'lgan Company.
  ownerCompanyId String
  ownerCompany   Company @relation("OwnFirmAccounts", fields: [ownerCompanyId], references: [id], onDelete: Cascade)
  inn            String
  /// Ekranda ko'rinadigan qisqa nom ("BAROKAT TEAM").
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports      BankStatementImport[]
  transactions BankTransaction[]

  @@index([ownerCompanyId])
  @@index([inn])
}

/// Bitta yuklangan vipiska fayli (audit izi: kim, qachon, nechta qator).
model BankStatementImport {
  id        String      @id @default(uuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName  String
  /// Parser formati: 'litsevoy' (Лицевой счет) | 'svedeniya' (Сведения о работе счета)
  format         String
  periodFrom     DateTime
  periodTo       DateTime
  openingBalance Decimal? @db.Decimal(14, 2)
  closingBalance Decimal? @db.Decimal(14, 2)
  /// Faylda topilgan / bazaga yozilgan / dublikat bo'lgani uchun tashlangan.
  rowsParsed    Int      @default(0)
  rowsInserted  Int      @default(0)
  rowsDuplicate Int      @default(0)
  importedBy    String?
  user          User?    @relation(fields: [importedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  transactions BankTransaction[]

  @@index([accountId, periodFrom])
  @@index([createdAt])
}

/// Vipiskadagi bitta qator. O'ZGARMAS: bank aytgani shu, uni tahrirlamaymiz —
/// faqat moslashtiramiz va undan boshqa yozuvlar hosil qilamiz.
model BankTransaction {
  id       String              @id @default(uuid())
  importId String
  import   BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  valueDate DateTime
  docNumber String?
  opCode    String?
  /// 'income' (kredit — pul tushdi) | 'expense' (debet — pul chiqdi)
  direction String
  amount    Decimal @db.Decimal(14, 2)

  counterpartyInn     String?
  counterpartyName    String?
  counterpartyAccount String?
  purpose             String? @db.Text
  /// To'lov maqsadidan ajratilgan shartnoma raqami ("02/26БК").
  contractHint String?
  /// Chiqim toifasi (soliq | bank_komissiya | xodim_kartasi | ijara | ...).
  expenseCategory String?

  /// Dublikat qalqoni: account+sana+hujjat+summa+yo'nalish+maqsad sha256.
  /// Xuddi shu faylni qayta yuklash yangi qator hosil qilmaydi.
  rawHash String @unique

  /// unmatched | matched | posted | ignored
  status String @default("unmatched")

  matchedCompanyId String?
  matchedCompany   Company?  @relation(fields: [matchedCompanyId], references: [id], onDelete: SetNull)
  matchedContractId String?
  matchedContract   Contract? @relation(fields: [matchedContractId], references: [id], onDelete: SetNull)
  /// Chiqim yozilganda hosil bo'lgan KassaEntry (FK emas — soft-delete bilan yashaydi).
  kassaEntryId String?

  ignoredReason String?
  postedAt      DateTime?
  postedBy      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  allocations PaymentAllocation[]

  @@index([accountId, valueDate])
  @@index([status])
  @@index([counterpartyInn])
  @@index([direction, status])
  @@index([matchedCompanyId])
}

/// Mijoz bilan tuzilgan shartnoma. Bitta mijozda bir nechta shartnoma
/// bo'lishi mumkin (1C reestrida shunday holat bor), shuning uchun bu alohida
/// jadval — Company.contractNumber bitta ustun bilan yetmaydi.
model Contract {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation("ClientContracts", fields: [companyId], references: [id], onDelete: Cascade)
  /// Shartnoma qaysi O'Z firmamiz nomidan tuzilgan.
  ownFirmId String?
  ownFirm   Company? @relation("OwnFirmContracts", fields: [ownFirmId], references: [id], onDelete: SetNull)

  /// "02/26БК" — vipiskadagi to'lov maqsadi bilan solishtiriladi.
  number   String
  signedAt DateTime?
  /// 1C reestridagi oylik summa.
  amount   Decimal? @db.Decimal(14, 2)
  currency String   @default("UZS")
  isActive Boolean  @default(true)
  /// manual | 1c_import
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations      PaymentAllocation[]
  bankTransactions BankTransaction[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([ownFirmId])
  @@index([number])
}

/// Bank tranzaksiyasining oylik Payment qatoriga taqsimoti.
/// Payment.amount = shu firmaning shu davrdagi allocation'lari yig'indisi.
/// Bitta TUSHUMNING oylik Payment qatoriga taqsimoti.
///
/// Manba uch xil bo'lishi mumkin — bank vipiskasi, plastik karta (1C
/// reestridan) va naqd. Uchalasi ham mijozning o'sha oydagi to'lovi, ya'ni
/// qarzini kamaytiradi. Shuning uchun `Payment.amount` HAR DOIM shu jadvaldagi
/// yig'indidan hisoblanadi: bitta mijoz oyda bankdan ham, plastikdan ham
/// to'lasa (real holat — iyulda 4 ta firma shunday qilgan), ikkalasi qo'shiladi.
model PaymentAllocation {
  id String @id @default(uuid())
  /// Faqat `source = "bank"` uchun to'ldiriladi.
  bankTransactionId String?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  paymentId         String
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contractId        String?
  contract          Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  amount            Decimal          @db.Decimal(14, 2)

  /// bank | plastik | naqd
  source String @default("bank")
  /// Manbadagi hujjat raqami (1C reestr nomeri) — takrorlanmaslik uchun.
  externalRef String?
  /// Pul qachon tushgan (bank uchun valyuta sanasi, plastik uchun reestr sanasi).
  receivedAt DateTime?

  /// Takrorlanmaslik kaliti: "bank:<txId>" yoki "plastik:<hujjat>:<STIR>".
  /// Yagona unikal ustun — chunki `bankTransactionId` endi NULL bo'lishi
  /// mumkin, Postgres'da esa NULL'lar bir-biridan farqli hisoblanadi va
  /// juftlik bo'yicha unikal indeks plastik qatorlarni ushlab qololmasdi.
  dedupKey String @unique

  createdBy String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([bankTransactionId])
  @@index([contractId])
  @@index([source])
}

/// Pul chiqadigan kanal. O'z bank hisobi va naqddan tashqari, ba'zi to'lovlar
/// o'zini-o'zi band qilgan xodimning kartasi orqali o'tadi — xodimlar ro'yxati
/// o'zgarib turadi, shuning uchun kanal alohida jadvalda.
model DisbursementChannel {
  id String @id @default(uuid())
  /// own_bank | employee_card | cash | plastik
  type       String
  label      String
  employeeId String?
  employee   User?   @relation("ChannelEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  /// "8600****4957" — to'liq karta raqami SAQLANMAYDI.
  cardMask  String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TransitEntry[]

  @@unique([type, cardMask])
  @@index([isActive])
  @@index([employeeId])
}

/// TRANZIT HARAKATI — xodim kartasidagi pul oqimi.
///
/// Ba'zi to'lovlar o'zini-o'zi band qilgan xodim kartasi orqali o'tadi:
///   bank hisobi ──(kirim)──► xodim kartasi ──(chiqim)──► ijara / aloqa / ovqat
///
/// Kartaga tushgan pul HALI XARAJAT EMAS — u firmaning pulligicha qoladi,
/// faqat boshqa joyda turadi. Xarajat kartadan sarflanganda yuz beradi.
/// Shuning uchun:
///   kirim  → faqat TransitEntry (KassaEntry YOZILMAYDI — aks holda xarajat
///            ikki marta: kartaga chiqqanda ham, sarflanganda ham sanalardi);
///   chiqim → TransitEntry + KassaEntry(expense) — mana shu haqiqiy xarajat.
///
/// Natijada har bir karta bo'yicha "qancha berildi / qancha sarflandi /
/// qancha qoldi" ko'rinadi.
model TransitEntry {
  id        String              @id @default(uuid())
  channelId String
  channel   DisbursementChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// 'in' — kartaga tushdi · 'out' — kartadan sarflandi
  direction String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  /// Chiqim toifasi (ijara | aloqa | ovqat | ...). Kirimda bo'sh.
  category    String?
  description String?

  /// Kirim manbai — vipiskadagi karta o'tkazmasi.
  bankTransactionId String?
  /// Chiqim natijasi — yozilgan KassaEntry (FK emas, soft-delete bilan yashaydi).
  kassaEntryId String?

  /// Takrorlanmaslik: "bank:<txId>" (kirim) yoki "out:<uuid>".
  dedupKey String @unique

  createdBy String?
  createdAt DateTime @default(now())

  @@index([channelId, date])
  @@index([direction])
}
