generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  super_admin
  admin
  chief_accountant
  supervisor
  accountant
  bank_manager
}

enum TaxRegime {
  vat
  turnover
  fixed
  yatt
  income
}

enum ReportStatus {
  accepted
  not_submitted
  not_required
  in_progress
  blocked
  error
  unknown
  rejected
  submitted
}

enum StatsType {
  kb1
  micro
  mehnat1
  small
}

enum AuditAction {
  create
  update
  delete
  login
  logout
}

// =====================================================
// USER (replaces Supabase auth.users + profiles)
// =====================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         UserRole  @default(accountant)
  avatarColor  String?   @default("hsl(200, 50%, 50%)")
  phone        String?
  pinfl        String? // JSHSHIR — 14 raqamli shaxsiy identifikatsiya raqami
  department   String?
  gender       String? // 'erkak' | 'ayol'
  birthDate    DateTime?
  education    String? // 'oliy' | 'orta' | 'magistratura'
  hiredAt      DateTime?
  firedAt      DateTime?
  status       String?   @default("active") // 'active' | 'vacation' | 'sick'
  rating       Int?

  // --- Telegram identity (KPI bot ↔ mehnat-ai user mapping) ---
  telegramUserId   BigInt? @unique
  telegramUsername String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedCompanies   Company[]            @relation("AccountantCompanies")
  supervisedCompanies Company[]            @relation("SupervisorCompanies")
  chiefCompanies      Company[]            @relation("ChiefAccountantCompanies")
  auditLogs           AuditLog[]
  notifications       Notification[]
  contractAssignments ContractAssignment[]
  performanceRecords  MonthlyPerformance[]
  payrollAdjustments  PayrollAdjustment[]
  kassaEntries        KassaEntry[]
  expenses            Expense[]
  attendances         Attendance[]         @relation("UserAttendance")
  assignedInventory   InventoryItem[]      @relation("UserAssignedInventory")
  payments            Payment[]
  payouts             Payout[]             @relation("EmployeePayouts")
  bankClientCompanies Company[]            @relation("BankClientCompanies")
  chiefDepartments    Department[]         @relation("DepartmentChief")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// =====================================================
// COMPANY
// =====================================================

model Company {
  id                String      @id @default(uuid())
  name              String
  inn               String
  taxRegime         TaxRegime   @default(vat)
  department        String?
  departmentId      String?
  departmentRef     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  accountantId      String?
  accountant        User?       @relation("AccountantCompanies", fields: [accountantId], references: [id], onDelete: SetNull)
  supervisorId      String?
  supervisor        User?       @relation("SupervisorCompanies", fields: [supervisorId], references: [id], onDelete: SetNull)
  chiefAccountantId String?
  chiefAccountant   User?       @relation("ChiefAccountantCompanies", fields: [chiefAccountantId], references: [id], onDelete: SetNull)

  // Login credentials
  login    String?
  password String?

  // Extended fields
  brandName      String?
  directorName   String?
  directorPhone  String?
  legalAddress   String?
  founderName    String?
  ownerName      String?
  bankClientId   String?
  bankClient     User?      @relation("BankClientCompanies", fields: [bankClientId], references: [id], onDelete: SetNull)
  bankClientName String?
  statsType      StatsType?
  kpiEnabled     Boolean    @default(false)
  serverInfo     String?
  serverName     String?
  baseName1c     String?
  contractAmount Decimal?   @db.Decimal(12, 2)
  contractNumber String?
  contractDate   DateTime?
  paymentDay     Int?

  // Tab 2: SOLIQ
  vatCertificateDate String?
  hasLandTax         Boolean @default(false)
  hasWaterTax        Boolean @default(false)
  hasPropertyTax     Boolean @default(false)
  hasExciseTax       Boolean @default(false)
  oneCStatus         String? // 'cloud' | 'local' | 'server' | 'none'
  oneCLocation       String?

  // Tab 6: XAVF
  companyStatus String? @default("active")
  riskLevel     String? @default("low")
  riskNotes     String?

  // Percentages
  accountantPerc      Decimal? @db.Decimal(5, 2)
  bankClientPerc      Decimal? @db.Decimal(5, 2)
  chiefAccountantPerc Decimal? @db.Decimal(5, 2)
  supervisorPerc      Decimal? @db.Decimal(5, 2)

  // Fixed-sum shares (so'm) — persist explicit amounts from source data
  accountantSum      Decimal? @db.Decimal(12, 2)
  bankClientSum      Decimal? @db.Decimal(12, 2)
  chiefAccountantSum Decimal? @db.Decimal(12, 2)
  supervisorSum      Decimal? @db.Decimal(12, 2)

  // Misc
  requiredReports      String[] // JSON array of report keys
  activeServices       String[] // Active service keys
  itParkResident       String?
  isInternalContractor Boolean  @default(false)
  notes                String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  monthlyReports      MonthlyReport[]
  financialReports    FinancialReport[]
  operations          Operation[]
  contractAssignments ContractAssignment[]
  documents           Document[]
  credentials         ClientCredential[]
  payments            Payment[]
  reportProofs        ReportProof[]
  telegramGroups      TelegramGroup[]
  paymentReminders    PaymentReminder[]

  @@index([accountantId])
  @@index([supervisorId])
  @@index([inn])
  @@index([isActive])
  @@index([departmentId])
}

// =====================================================
// DEPARTMENT (bo'lim — har bo'lim bir bosh buxgalterga tegishli)
// =====================================================

model Department {
  id                String   @id @default(uuid())
  name              String   @unique
  chiefAccountantId String?
  chiefAccountant   User?    @relation("DepartmentChief", fields: [chiefAccountantId], references: [id], onDelete: SetNull)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companies Company[]

  @@index([chiefAccountantId])
}

// =====================================================
// MONTHLY REPORT (company_monthly_reports)
// =====================================================

model MonthlyReport {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2025-02"

  // All operation columns
  bankKlient          String?
  didox               String?
  xatlar              String?
  avtokameral         String?
  myMehnat            String?
  oneC                String?
  pulOqimlari         String?
  chiqadiganSoliqlar  String?
  hisoblananOylik     String?
  debitorKreditor     String?
  foydaVaZarar        String?
  tovarOstatka        String?
  ndsBekorQilish      String?
  aylanmaQqs          String?
  daromadSoliq        String?
  inps                String?
  foydaSoliq          String?
  moliyaviyNatija     String?
  buxgalteriyaBalansi String?
  statistika          String?
  bonak               String?
  yerSoligi           String?
  molMulkSoligi       String?
  suvSoligi           String?

  // Statistika 2026
  stat12Invest     String?
  stat12Moliya     String?
  stat12Korxona    String?
  stat12Narx       String?
  stat4Invest      String?
  stat4Mehnat      String?
  stat4KorxonaMiz  String?
  stat4KbQurSavXiz String?
  stat4KbSanoat    String?
  stat1Invest      String?
  stat1Ih          String?
  stat1Energiya    String?
  stat1Korxona     String?
  stat1KorxonaTif  String?
  stat1Moliya      String?
  stat1Akt         String?

  // Qo'shimcha soliqlar / IT Park / Komunalka
  aksizSoligi       String?
  nedroSoligi       String?
  norezidentFoyda   String?
  norezidentNds     String?
  aylanmaQqsTolov   String?
  daromadSoliqTolov String?
  inpsTolov         String?
  foydaSoliqTolov   String?
  itparkOylik       String?
  itparkChorak      String?
  komSuv            String?
  komGaz            String?
  komSvet           String?

  comment   String?
  updatedAt DateTime @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
}

// =====================================================
// REPORT PROOF (Buxgalter topshirgan skrinshot dalili + nazoratchi tasdig'i)
// Har bir katak = (firma + davr + ustun) uchun bitta joriy dalil.
// =====================================================
model ReportProof {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2026-03"
  colKey    String // OperationModule REPORT_COLUMNS kaliti, masalan "didox"

  imageData String  @db.Text // skrinshot (base64 data URL, klient tomonda siqilgan)
  note      String? // buxgalterning izohi

  status String @default("pending") // pending | approved | rejected

  submittedById   String
  submittedByName String
  submittedAt     DateTime @default(now())

  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  rejectReason   String?

  updatedAt DateTime @updatedAt

  @@unique([companyId, period, colKey])
  @@index([companyId])
  @@index([period])
  @@index([status])
}

// =====================================================
// PAYMENT (Kassa — firma shartnoma to'lovlari, oylik)
// =====================================================

// Moliyaviy hisobot hujjatlari (Foyda/zarar, Balans, QQS, Pul oqimi) — ASRO Hisobotlar moduli
model FinancialReport {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String // 'profit_loss' | 'balance' | 'qqs' | 'cashflow'
  period         String // "2026-H1" | "2026-07"
  status         String    @default("preparing") // preparing | ready | signing | submitted | rejected
  deadline       DateTime?
  assignedTo     String? // employeeId (mas'ul)
  data           Json      @default("{}") // hisobot satrlari (viewer uchun)
  fileFormat     String? // 'PDF' | 'XLS'
  signedBy       String?
  signedAt       DateTime?
  submittedAt    DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([status])
}

model Payment {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period        String // "2026-07"
  amount        Decimal   @db.Decimal(12, 2)
  paymentDate   DateTime?
  status        String    @default("pending") // 'paid' | 'pending' | 'partial' | 'overdue'
  paymentMethod String    @default("naqd") // 'naqd' | 'plastik' | 'schyot' | 'terminal' | 'boshqa'
  comment       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  user          User?     @relation(fields: [createdBy], references: [id])

  // Soft delete — moliyaviy yozuv hech qachon jismonan o'chirilmaydi
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
  @@index([status])
  @@index([deletedAt])
}

// =====================================================
// OPERATION (annual/quarterly reports)
// =====================================================

model Operation {
  id                String       @id @default(uuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period            String // "2024 Yillik"
  profitTaxStatus   ReportStatus @default(not_submitted)
  form1Status       ReportStatus @default(not_submitted)
  form2Status       ReportStatus @default(not_submitted)
  statsStatus       ReportStatus @default(not_submitted)
  comment           String?
  deadlineProfitTax DateTime?
  deadlineStats     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
}

// =====================================================
// KPI RULES (Dynamic KPI system)
// =====================================================

model KpiRule {
  id             String  @id @default(uuid())
  name           String  @unique // Internal: "telegram_response"
  nameUz         String // O'zbekcha: "Telegramda javob"
  role           String // 'accountant' | 'bank_client' | 'supervisor' | 'all'
  rewardPercent  Decimal @db.Decimal(5, 2)
  penaltyPercent Decimal @db.Decimal(5, 2)
  inputType      String // 'checkbox' | 'counter' | 'number' | 'rating'
  category       String // 'attendance', 'telegram', 'reports'
  description    String?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  // --- KPI v2 (uch holatli tizim: bonus / neytral / jarima) ---
  descriptionUz String? // O'zbekcha batafsil izoh
  options       Json     @default("[]") // [{ key, label_uz, color, coeff | coeff_per_unit, max_coeff, note }]
  inputTypeV2   String   @default("select") // 'select' | 'counter' | 'checkbox_bonus' | 'checkbox_penalty' | 'amount_penalty'
  scope         String   @default("global") // 'global' | 'per_company' | 'per_group'
  maxBonus      Decimal? @db.Decimal(6, 2)
  maxPenalty    Decimal? @db.Decimal(6, 2)

  performances MonthlyPerformance[]
  companyRules CompanyKpiRule[]
}

model CompanyKpiRule {
  id             String   @id @default(uuid())
  companyId      String
  ruleId         String
  rule           KpiRule  @relation(fields: [ruleId], references: [id])
  rewardPercent  Decimal? @db.Decimal(5, 2)
  penaltyPercent Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)

  @@unique([companyId, ruleId])
}

// =====================================================
// MONTHLY PERFORMANCE (KPI entries)
// =====================================================

model MonthlyPerformance {
  id                     String    @id @default(uuid())
  month                  String // '2026-02-01'
  companyId              String
  employeeId             String
  employee               User      @relation(fields: [employeeId], references: [id])
  ruleId                 String
  rule                   KpiRule   @relation(fields: [ruleId], references: [id])
  value                  Decimal   @db.Decimal(10, 2)
  calculatedScore        Decimal   @db.Decimal(10, 2)
  rewardPercentOverride  Decimal?  @db.Decimal(5, 2)
  penaltyPercentOverride Decimal?  @db.Decimal(5, 2)
  // --- KPI v2 kirish maydonlari ---
  selectedOption         String? // Nazoratchi tanlagan option key (green/yellow/red holati)
  earlyDays              Int       @default(0) // 08:30 gacha kelgan kunlar (bonus counter)
  lateMinutes            Int       @default(0) // Kechikkan daqiqalar (counter qoidalar uchun)
  absentDays             Int       @default(0) // Uzrsiz kelmagan kunlar soni
  penaltyAmount          Decimal   @default(0) @db.Decimal(12, 2) // Qo'lda kiritilgan jarima summasi (amount_penalty)
  source                 String? // 'employee' | 'supervisor' | 'chief' | 'system'
  status                 String    @default("draft")
  submittedBy            String?
  submittedAt            DateTime?
  approvedBy             String?
  approvedAt             DateTime?
  rejectedReason         String?
  notes                  String?
  changeReason           String?
  recordedAt             DateTime  @default(now())

  // One Monthly Performance per rule, per employee, per Company, per month.
  // Payroll sums every approved row and penalties are uncapped, so a duplicate
  // is not a cosmetic issue — it multiplies a penalty into someone's salary.
  // See ADR-0004 and ADR-0001.
  @@unique([month, companyId, employeeId, ruleId])
  @@index([employeeId])
  @@index([companyId])
  @@index([month])
}

// =====================================================
// PAYROLL ADJUSTMENT
// =====================================================

// MAJBURIYAT qatlami: hisoblangan oylik ('payment'), avans, jarima, bonus.
// REAL pul berish alohida Payout jadvalida — majburiyat ≠ to'lov (ERP ajratuvi).
model PayrollAdjustment {
  id             String    @id @default(uuid())
  month          String
  employeeId     String
  employee       User      @relation(fields: [employeeId], references: [id])
  adjustmentType String // 'bonus' | 'avans' | 'jarima' | 'payment' | 'manual' | 'other'
  amount         Decimal   @db.Decimal(12, 2)
  reason         String
  approvedBy     String?
  approvedAt     DateTime?
  isApproved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  createdBy      String?

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  payouts Payout[]

  @@index([employeeId, month])
  @@index([deletedAt])
}

// =====================================================
// PAYOUT — REAL berilgan pul (majburiyatdan ajratilgan)
// =====================================================
// PayrollAdjustment "qancha to'lash kerak"ni aytadi; Payout "qancha, qachon,
// kim tomonidan, qanday usulda haqiqatan berildi"ni yozadi. Balans/cashflow
// faqat Payout'ni chiqim deb sanaydi. adjustmentId — majburiyat havolasi
// (tasdiqlangan 'payment'/'avans' qatori).
model Payout {
  id            String             @id @default(uuid())
  employeeId    String
  employee      User               @relation("EmployeePayouts", fields: [employeeId], references: [id])
  companyId     String?
  adjustmentId  String?
  adjustment    PayrollAdjustment? @relation(fields: [adjustmentId], references: [id])
  month         String // "YYYY-MM" — qaysi oy majburiyati uchun
  amount        Decimal            @db.Decimal(12, 2) // har doim musbat
  paymentMethod String             @default("naqd") // 'naqd' | 'plastik' | 'schyot' | 'terminal' | 'boshqa'
  note          String?
  paidAt        DateTime           @default(now())
  createdBy     String?
  createdAt     DateTime           @default(now())

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([employeeId, month])
  @@index([adjustmentId])
  @@index([paidAt])
  @@index([deletedAt])
}

// =====================================================
// DOUBLE-ENTRY LEDGER — har harakat ikki tomonlama
// =====================================================
// Append-only: yozuv hech qachon o'zgartirilmaydi/o'chirilmaydi; tuzatish
// faqat reversal (teskari) entry orqali. transactionId ikki oyoqni bog'laydi;
// har tranzaksiyada Σdebit == Σcredit (lib/ledger.ts kafolatlaydi).
model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String // lib/ledger.ts ACCOUNTS: CASH | CONTRACT_INCOME | KASSA_INCOME | OPERATING_EXPENSE | SALARY_EXPENSE
  debit         Decimal  @default(0) @db.Decimal(14, 2)
  credit        Decimal  @default(0) @db.Decimal(14, 2)
  description   String?
  sourceTable   String? // Expense | KassaEntry | Payment | Payout (+ '-reversal')
  sourceId      String?
  period        String // "YYYY-MM"
  createdAt     DateTime @default(now())
  createdBy     String?

  @@index([transactionId])
  @@index([accountId, period])
  @@index([sourceTable, sourceId])
  @@index([period])
}

// =====================================================
// ACCOUNTING PERIOD — oy yopilishi holat mashinasi
// =====================================================
// Statuslar: OPEN → READY_TO_CLOSE → CLOSING → LOCKED → (REOPENED) → CLOSING...
// FAILED = oxirgi yopish urinishi checklist/xato bilan yiqilgan (yozish ochiq).
// LOCKED va CLOSING davrlarga hech qanday moliyaviy mutation kirmaydi
// (lib/periodLock.ts). companyId null = butun firma (global). Global (year,month)
// yagona — migratsiyadagi partial unique index bilan (Postgres NULL-unique).
model AccountingPeriod {
  id        String    @id @default(uuid())
  companyId String? // null = global
  year      Int
  month     Int // 1-12
  status    String    @default("OPEN") // OPEN | READY_TO_CLOSE | CLOSING | LOCKED | REOPENED | FAILED
  lockedBy  String?
  lockedAt  DateTime?

  // Month-end closing metadata
  openingBalance Decimal?  @db.Decimal(14, 2) // yopilganda / keyingi oy yaratilganda to'ldiriladi
  closedBy       String?
  closedAt       DateTime?
  reopenedBy     String?
  reopenedAt     DateTime?
  reopenReason   String?
  statusNote     String? // FAILED sababi (checklist xatolari qisqartmasi)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year, month])
  @@index([year, month])
  @@index([status])
}

// =====================================================
// FINANCIAL SNAPSHOT — davr yopilishi qoldiqlari (IMMUTABLE)
// =====================================================
// period = "YYYY-MM" (oy yopilishi) yoki "YYYY" (yil yopilishi).
// closingBalance = openingBalance + income − outflow.
// IMMUTABLE: moliyaviy ustunlar DB-darajali trigger bilan qulflangan
// (migratsiya financial_snapshot_immutable) — faqat isValid/invalidated*
// belgilarini o'zgartirish mumkin (reopen invalidatsiyasi). Global period
// yagona — partial unique index bilan.
model FinancialSnapshot {
  id             String   @id @default(uuid())
  companyId      String? // null = butun firma
  period         String // "2026-01" | "2026"
  openingBalance Decimal  @db.Decimal(14, 2)
  closingBalance Decimal  @db.Decimal(14, 2)
  income         Decimal  @default(0) @db.Decimal(14, 2)
  outflow        Decimal  @default(0) @db.Decimal(14, 2)

  // Month-end kengaytmasi
  payrollTotal  Decimal @default(0) @db.Decimal(14, 2) // oy ichida berilgan oyliklar (Payout)
  cashIn        Decimal @default(0) @db.Decimal(14, 2) // ledger CASH debit (davr)
  cashOut       Decimal @default(0) @db.Decimal(14, 2) // ledger CASH credit (davr)
  ledgerBalance Decimal @default(0) @db.Decimal(14, 2) // yopilish paytidagi ledger CASH qoldig'i
  profit        Decimal @default(0) @db.Decimal(14, 2) // max(0, income − outflow)
  loss          Decimal @default(0) @db.Decimal(14, 2) // max(0, outflow − income)
  employeeCount Int     @default(0)
  companyCount  Int     @default(0)
  checksum      String? // sha256 — moliyaviy maydonlar ustidan (lib/snapshot.ts)

  // Reopen invalidatsiyasi (trigger ruxsat bergan yagona o'zgarish)
  isValid       Boolean   @default(true)
  invalidatedAt DateTime?
  invalidatedBy String?
  invalidReason String?

  createdBy String?
  createdAt DateTime @default(now())

  @@unique([companyId, period])
  @@index([period])
  @@index([isValid])
}

// =====================================================
// CONTRACT ASSIGNMENT
// =====================================================

model ContractAssignment {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String // 'accountant' | 'controller' | 'bank_manager' | 'chief' | 'chief_accountant'
  salaryType  String // 'percent' | 'fixed'
  salaryValue Decimal   @db.Decimal(12, 2)
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([userId])
}

// =====================================================
// CLIENT CREDENTIALS
// =====================================================

model ClientCredential {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceName       String // 'soliq' | 'didox' | 'my_mehnat' | 'bank_client'
  loginId           String
  encryptedPassword String
  keyFilePath       String?
  notes             String?
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  @@index([companyId])
}

// =====================================================
// KASSA
// =====================================================

model KassaEntry {
  id          String   @id @default(uuid())
  companyId   String?
  type        String // 'income' | 'expense'
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id])

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([date])
  @@index([type])
  @@index([deletedAt])
}

// =====================================================
// EXPENSE
// =====================================================

model Expense {
  id             String    @id @default(uuid())
  amount         Decimal   @db.Decimal(12, 2)
  date           DateTime
  category       String
  paymentMethod  String    @default("naqd") // 'naqd' | 'plastik' | 'schyot' | 'terminal' | 'boshqa'
  description    String?
  // Tasdiqlash oqimi: <1mln avto, 1-10mln Bosh Buxgalter, >10mln + Superadmin
  status         String    @default("pending") // pending | approved | rejected
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  createdBy      String?
  user           User?     @relation(fields: [createdBy], references: [id])

  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?

  @@index([date])
  @@index([category])
  @@index([status])
  @@index([deletedAt])
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  tableName String
  recordId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([tableName])
  @@index([createdAt])
}

// =====================================================
// NOTIFICATION
// =====================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'deadline' | 'status_change' | 'kpi_alert' | 'system' | 'approval_request'
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// =====================================================
// DOCUMENT
// =====================================================

model Document {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  filePath   String
  fileSize   Int?
  mimeType   String?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([companyId])
}

// =====================================================
// ATTENDANCE & INVENTORY
// =====================================================

model Attendance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("present") // present, absent, late, excused
  notes       String?
  source      String?   @default("manual") // 'manual' | 'ejurnal' — where the record came from
  lateMinutes Int?      @default(0) // minutes the check-in is past the 09:00 threshold
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([date])
}

model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  serialNumber String?  @unique
  status       String   @default("available") // available, assigned, maintenance, retired
  condition    String   @default("good")
  assignedToId String?
  assignedTo   User?    @relation("UserAssignedInventory", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
}

// =====================================================
// SYSTEM SETTING (global admin-managed key/value config)
// =====================================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

// =====================================================
// TELEGRAM KPI BOT
// Signal-capture + question/answer + immutable KPI ledger.
// The bot writes here; the existing KPI engine (KpiRule /
// MonthlyPerformance / PayrollAdjustment) and dashboards read it.
// See KPI_BOT_BLUEPRINT.md and bot/README.md.
// =====================================================

// Firma ↔ Telegram guruh. One company may map to several chats.
model TelegramGroup {
  id        String   @id @default(uuid())
  chatId    BigInt   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Idempotency ledger: Telegram delivers at-least-once, so each update_id is
// processed exactly once. The webhook/worker upserts here before doing work.
model ProcessedUpdate {
  updateId    BigInt   @id
  processedAt DateTime @default(now())

  @@index([processedAt]) // for periodic cleanup of old dedup rows
}

// Full message capture (text / reply / edit / delete / reaction / media / voice).
// No @@unique([chatId, messageId]): edits & reactions are appended as separate
// rows (message history), and dedup is guaranteed upstream by ProcessedUpdate.
model TelegramMessage {
  id              String   @id @default(uuid())
  updateId        BigInt? // source Telegram update_id (trace)
  chatId          BigInt
  messageId       BigInt
  fromUserId      BigInt? // Telegram numeric id of the sender
  userId          String? // mapped mehnat-ai User id, when known
  text            String?  @db.Text
  kind            String // 'text'|'reply'|'edit'|'delete'|'reaction'|'media'|'voice'|'file'
  replyToId       BigInt?
  mediaType       String?
  voiceTranscript String?  @db.Text // STT result
  createdAt       DateTime // Telegram message time
  loggedAt        DateTime @default(now()) // when the bot captured it

  @@index([chatId, createdAt]) // scale / future partitioning key
  @@index([chatId, messageId]) // reply resolution
  @@index([userId, createdAt])
}

// Question state machine. Deadline = ResponseWindow × WorkingHours (domain layer).
model Question {
  id                String    @id @default(uuid())
  chatId            BigInt
  companyId         String?
  messageId         BigInt
  askedByUserId     BigInt?
  text              String?   @db.Text
  responsibleRole   String // 'accountant'|'bank_client'|'controller'
  responsibleUserId String? // resolved mehnat-ai User, when known
  status            String    @default("pending") // pending|answered|late|closed
  deadlineAt        DateTime
  answeredAt        DateTime?
  aiConfidence      Decimal?  @db.Decimal(4, 3) // AI classifier confidence 0.000–1.000
  createdAt         DateTime  @default(now())
  answers           Answer[]

  @@index([status, deadlineAt]) // critical for the pending-only deadline sweep
  @@index([companyId])
  @@index([chatId, messageId])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  byUserId   String?
  messageId  BigInt
  createdAt  DateTime @default(now())

  @@index([questionId])
}

// Immutable KPI ledger — every bonus/penalty is a signed, append-only row.
// Rolled up into MonthlyPerformance; never mutated (corrections = new rows).
model KpiEvent {
  id          String   @id @default(uuid())
  employeeId  String // mehnat-ai User id
  companyId   String?
  ruleId      String? // which KpiRule was applied
  periodMonth String // "2026-07"
  type        String // 'response'|'attendance'|'report'|'manual'
  points      Decimal  @db.Decimal(10, 4) // signed: + bonus / − penalty
  sourceRef   String? // Question.id / Attendance.id / ...
  meta        Json     @default("{}")
  createdBy   String? // for manual adjustments: who
  createdAt   DateTime @default(now())

  @@index([employeeId, periodMonth])
  @@index([companyId, periodMonth])
  @@index([periodMonth])
}

// Escalation delivery record (🟡🟠🔴) for a Notification over a channel.
model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String?
  channel        String // 'telegram'|'inapp'
  level          String // 'yellow'|'orange'|'red'
  targetChatId   BigInt?
  status         String    @default("pending") // pending|sent|failed
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
}

// Payment-reminder trail. @@unique([companyId, period, level]) makes each
// escalation step fire once per company+period — no spam, restart-safe.
model PaymentReminder {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    String // "2026-07" (matches Payment.period)
  level     String // 'yellow'|'orange'|'red'
  amountDue Decimal  @db.Decimal(12, 2) // debt at reminder time
  chatId    BigInt? // which group it was sent to
  status    String   @default("sent") // sent|failed|skipped
  sentAt    DateTime @default(now())

  @@unique([companyId, period, level])
  @@index([period])
  @@index([status])
}
