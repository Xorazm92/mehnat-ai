# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...lekin shablon fayl repoda TURISHI KERAK — unda hech qanday real sir yo'q,
# faqat o'zgaruvchilar ro'yxati va ularni to'ldirish bo'yicha izoh.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# internal working docs
HANDOFF.md
cookies.txt

# database dumps / backups (never commit real data)
mehnat_full_backup.sql
backup_*.sql
*_backup.sql
*.dump
backups/
import_log.txt

# Bank vipiskalari va 1C shartnoma reestrlari — HAQIQIY MOLIYAVIY MA'LUMOT.
# Bularda mijozlarning STIR'i, hisob raqamlari, to'lov summalari va xodimlarning
# karta raqamlari bor. Repozitoriyga ham, serverga ham CHIQMAYDI — ular faqat
# import uchun mahalliy manba, ma'lumot esa bazada yashaydi:
#   npx tsx scripts/mark-own-firms.ts
#   npx tsx scripts/import-contracts.ts --apply
#   npx tsx scripts/import-statements.ts
cash_json_files/
contract_json_files/
# Vipiska/reestr asl fayllari (xlsx/xls) ham hech qachon commit qilinmasin.
*.xlsx
*.xls

# Korxona ichki hisob fayllari (tranzit daftari, qarzdorlik, kassa, reja/fakt).
# Ichida xodimlarning karta raqami, JSHSHIR va mijozlar qarzdorligi bor —
# repozitoriyga ham, serverga ham chiqmaydi. Ma'lumot bazada yashaydi.
others_json_files/
# Boshida `kassa/` deb yozilgan edi — u naqsh ILDIZGA BOG'LANMAGAN va
# `app/(dashboard)/kassa/` UI modulini ham jimgina gitdan yashirardi.
# Boshidagi `/` uni faqat repozitoriy ildizidagi papkaga qaratadi.
/kassa/

# Recovery sprint ish fayllari (majburiyat ID ro'yxatlari, baseline snapshotlar)
.recovery/

# Tashqi loyiha nusxasi (Twenty CRM) — tahlil uchun, kodimizga aloqasi yo'q.
twenty-main/

# Dalil/hujjat fayllari ombori — mijoz hujjatlari, repozitoriyaga tushmaydi.
storage/

# Agent skilllari — lokal asboblar, ilova kodi emas. Diskda qoladi va
# ishlayveradi; git ularni kuzatmaydi. Qaysi skill o'rnatilgani
# `skills-lock.json` da qayd etiladi, ya'ni kerak bo'lsa qayta tiklanadi.
/.agents/skills/
# Xuddi shu sabab bilan Claude Code skilllari ham kuzatilmaydi — ular lokal
# asboblar, ilova kodi emas. Hooks va settings.json esa repoda qoladi.
/.claude/skills/

# Migratsiya rollback yozuvlari — prod qator IDlari; zaxira bilan birga saqlanadi,
# git ga tushmaydi (docs/plan/service-key-migration-runbook.md ga qarang).
.migrations/

# Ish manbalari ombori — HAQIQIY MA'LUMOT, repozitoriyga chiqmaydi.
# Ichida: firmalar reyestri (nom, STIR, xizmat haqi, xodim ulushlari),
# kpi-oylik.json, eski Supabase davridan qolgan skriptlar (ularda ochiq
# service_role kalitlari va parollar bor) va "Finansistlar uchun tizim dizayni"
# HTML maketlari. Diskda qoladi — import skriptlari uni o'qiydi:
#   npx tsx scripts/import-yorqinoy-firmalar.ts
#   npx tsx scripts/seed-kpi-monthly.ts
/data/
